# Copy to .env (repo root). Read by docker compose and by the API.

# API
PORT=3000
DATABASE_URL=postgresql://docsign:docsign@localhost:5432/docsign

# PostgreSQL (docker)
POSTGRES_USER=docsign
POSTGRES_PASSWORD=docsign
POSTGRES_DB=docsign
POSTGRES_PORT=5432

# Storage: MinIO locally (S3-compatible). Also the MinIO root credentials.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Email: Mailpit locally (SMTP, no auth)
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
EMAIL_FROM="מערכת חתימות <no-reply@doc-signing.local>"
