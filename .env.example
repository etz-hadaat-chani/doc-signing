# Copy to .env (repo root). Read by docker compose and by the API.

# API
# development | test | production (default development). Checked at startup with the rest.
NODE_ENV=development
PORT=3000
# The port in DATABASE_URL must match POSTGRES_PORT.
DATABASE_URL=postgresql://docsign:docsign@localhost:5432/docsign
# DB tests use their own database (created and migrated automatically). Defaults to
# DATABASE_URL with the name docsign_test; the name must end in _test.
# TEST_DATABASE_URL=postgresql://docsign:docsign@localhost:5432/docsign_test

# Seed (pnpm db:seed, dev only): password for the seeded manager and officer
# (manager@doc-signing.local, officer@doc-signing.local). The seed refuses to run in production.
SEED_USER_PASSWORD=change-me-dev-only

# PostgreSQL (docker)
POSTGRES_USER=docsign
POSTGRES_PASSWORD=docsign
POSTGRES_DB=docsign
POSTGRES_PORT=5432

# Storage: MinIO locally (S3-compatible). Also the MinIO root credentials. Checked at startup;
# values are never printed. The bucket is private; dev and test create it when missing,
# production never does (create it with the infrastructure).
# S3_ENDPOINT: empty for AWS S3. S3_FORCE_PATH_STYLE: true for MinIO, false for AWS S3.
# S3_ACCESS_KEY / S3_SECRET_KEY: both or neither; leave both empty in production to use the
# server's IAM role.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Tests use their own bucket. Defaults to S3_BUCKET + "-test"; the name must end in -test.
# TEST_S3_BUCKET=documents-test

# Email: Mailpit locally (SMTP, no auth)
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="מערכת חתימות <no-reply@doc-signing.local>"
