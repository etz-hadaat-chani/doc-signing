# Copy to .env (repo root). Read by docker compose and by the API.

# API
# development | test | production (default development). Checked at startup with the rest.
NODE_ENV=development
PORT=3000
# The port in DATABASE_URL must match POSTGRES_PORT.
DATABASE_URL=postgresql://docsign:docsign@localhost:5432/docsign
# DB tests use their own database (created and migrated automatically). Defaults to
# DATABASE_URL with the name docsign_test; the name must end in _test.
# TEST_DATABASE_URL=postgresql://docsign:docsign@localhost:5432/docsign_test

# Seed (pnpm db:seed, dev only): password for the seeded manager and officer
# (manager@doc-signing.local, officer@doc-signing.local). The seed refuses to run in production.
SEED_USER_PASSWORD=change-me-dev-only

# PostgreSQL (docker)
POSTGRES_USER=docsign
POSTGRES_PASSWORD=docsign
POSTGRES_DB=docsign
POSTGRES_PORT=5432

# Storage: MinIO locally (S3-compatible). Also the MinIO root credentials. Checked at startup;
# values are never printed. The bucket is private; dev and test create it when missing,
# production never does (create it with the infrastructure).
# S3_ENDPOINT: empty for AWS S3. S3_FORCE_PATH_STYLE: true for MinIO, false for AWS S3.
# S3_ACCESS_KEY / S3_SECRET_KEY: both or neither; leave both empty in production to use the
# server's IAM role.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Tests use their own bucket. Defaults to S3_BUCKET + "-test"; the name must end in -test.
# TEST_S3_BUCKET=documents-test

# Email (SMTP): Mailpit locally, no login. Checked at startup; values are never printed.
# SMTP_SECURE=true for TLS from the start (port 465); false = STARTTLS when offered (always
# required in production). SMTP_USER / SMTP_PASSWORD: both or neither.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Address only; the display name is the sender_name setting (default "מערכת חתימות").
EMAIL_FROM_ADDRESS=no-reply@doc-signing.local
# Base of the signing links in emails (<APP_PUBLIC_URL>/sign/<token>); https in production.
APP_PUBLIC_URL=http://localhost:5173
# HR contact: the built-in default of the hr_contact setting (a manager can change it in the
# settings), shown in every email footer and on the signing pages. Phone, email or both.
HR_CONTACT_NAME="מחלקת משאבי אנוש"
HR_CONTACT_PHONE=02-0000000
HR_CONTACT_EMAIL=hr@doc-signing.local
# Emails a second, at most, per worker process (default 10). Production runs one worker, so this
# is the system's limit: keep it under the provider's (AWS SES sandbox 1, production starts at 14).
# Mailpit has no limit. 1,500 invitations take about 2.5 minutes at 10.
# EMAIL_SEND_RATE_PER_SECOND=10
# Proxies in front of the API (a cloud load balancer = 1), so the employee's real IP is used for
# signer_ip and the per-IP limits. 0 = none (local). Required in production; never "trust all".
# TRUST_PROXY_HOPS=0
# Per-IP limits of the public signing routes, requests per IP per 15 minutes (task 3.13). They
# only stop floods: hundreds of employees may share one filter IP (NetFree, Etrog, Nativ, Rimon).
# Defaults fit ~200 employees signing from one IP at once; a value under the minimum is refused.
# SIGN_RATE_LIMIT_ALL=6000           # every signing route (minimum 600)
# SIGN_RATE_LIMIT_STATE=2000         # link state (minimum 200)
# SIGN_RATE_LIMIT_VERIFY=1000        # ID checks (minimum 100)
# SIGN_RATE_LIMIT_VERIFY_WRONG=300   # wrong ID numbers (minimum 30)
# SIGN_RATE_LIMIT_DOCUMENT=1000      # the document PDF (minimum 60)
# SIGN_RATE_LIMIT_FORM=1000          # the form (minimum 100)
# SIGN_RATE_LIMIT_FIT=4000           # "does my text fit" (minimum 300)
# SIGN_RATE_LIMIT_SUBMIT=300         # signatures (minimum 30)
# Email tests and `pnpm email:preview` read the messages back from Mailpit's API.
# MAILPIT_API_URL=http://localhost:8025
