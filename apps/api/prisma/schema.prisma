// Database schema (PRD section 12). The connection URL comes from prisma.config.ts.
//
// Conventions for every model:
// - Models are PascalCase, mapped to snake_case plural tables:   model Employee { ... @@map("employees") }
// - Fields are camelCase, mapped to snake_case columns:          employeeNumber String @map("employee_number")
// - Enums are PascalCase, mapped to snake_case types; values are exactly as in the PRD.
// - Primary keys are uuid, generated by the database:
//     id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
//   Foreign keys to them are @db.Uuid too. PRD exceptions: audit_log (bigserial),
//   settings (key), template_departments (composite key).
// - Dates are timestamptz with millisecond precision: @db.Timestamptz(3)
// - Every table has (except audit_log: append-only, createdAt only):
//     createdAt DateTime @default(now())            @map("created_at") @db.Timestamptz(3)
//     updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
//   (@default(now()) on updatedAt gives the column a database default, for rows inserted by raw SQL.)
// - Every relation sets onDelete: Restrict. Rows are archived (isActive / isArchived), never deleted.
// - Constraints Prisma can't express (e.g. UNIQUE NULLS NOT DISTINCT, CHECK) go in the migration SQL.
//   Current CHECKs: employees.id_number ~ '^[0-9]{9}$';
//   templates.version >= 1, templates.page_count >= 1;
//   template_fields.page >= 1, x >= 0, y >= 0, width > 0, height > 0, font_size > 0 (NULL allowed);
//   rounds.reminder_interval_days > 0, max_reminders > 0 (NULL allowed);
//   assignments.failed_attempts 0–5, reminder_count >= 0, signed_file_sha256 64 lowercase hex,
//   template_id or source_file_key set, signed/signed_manual need signed_at and signed_file_key;
//   email_messages.token_hash 64 lowercase hex, NULL exactly when type = signed_copy;
//   audit_log.actor_type = 'user' exactly when user_id is set.
//   sessions.token_hash 64 lowercase hex.
//   Unique index with NULLS NOT DISTINCT: round_templates (round_id, department_id).
// - audit_log is append-only: triggers in the migration SQL reject UPDATE, DELETE and TRUNCATE.
//   The test reset bypasses them with session_replication_role = replica (test/setup/database.ts).
// - Exception to "never deleted": sessions and login_attempts rows are short-lived and deleted
//   (logout, expiry, cleanup job in task 2.7). Nothing references them.
// - Staff emails (users.email) are stored lowercase; the unique index is on the stored value.
//   Enforced in code (task 3.1), not by the database.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// users.role
enum UserRole {
  manager
  officer

  @@map("user_role")
}

// employees.email_status
enum EmailStatus {
  valid
  missing
  invalid
  bounced

  @@map("email_status")
}

// import_batches.status
enum ImportStatus {
  preview
  committed
  failed

  @@map("import_status")
}

// templates.kind. MVP uses only `signature`.
enum TemplateKind {
  signature
  acknowledgment
  external_report

  @@map("template_kind")
}

// template_fields.field_type. `checkbox` and `text` are for later.
enum TemplateFieldType {
  full_name
  id_number
  date
  signature
  checkbox
  text

  @@map("template_field_type")
}

// rounds.mode
enum RoundMode {
  single_template
  by_department

  @@map("round_mode")
}

// rounds.status
enum RoundStatus {
  draft
  sending
  active
  closed
  cancelled

  @@map("round_status")
}

// assignments.status. `delivered` is used only by delivery-only rounds (later).
// Locked and expired are flags, not statuses (see displayStatus()).
enum AssignmentStatus {
  pending
  sent
  opened
  signed
  signed_manual
  delivered
  no_email
  invalid_email
  cancelled

  @@map("assignment_status")
}

// assignments.sign_method
enum SignMethod {
  digital
  manual
  kiosk

  @@map("sign_method")
}

// email_messages.type
enum EmailMessageType {
  invite
  reminder
  signed_copy

  @@map("email_message_type")
}

// email_messages.status
enum EmailMessageStatus {
  queued
  sent
  delivered
  bounced
  failed

  @@map("email_message_status")
}

// audit_log.actor_type
enum ActorType {
  user
  employee
  system

  @@map("actor_type")
}

// ---------------------------------------------------------------------------
// Employees (task 1.2)
// ---------------------------------------------------------------------------

// Staff users (managers and officers).
model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName     String    @map("full_name") @db.VarChar(100)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") // Argon2
  role         UserRole
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  importBatches      ImportBatch[]
  templates          Template[]
  rounds             Round[]
  handledAssignments Assignment[]
  auditLogs          AuditLog[]
  updatedSettings    Setting[]
  sessions           Session[]

  @@map("users")
}

model Department {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      Int      @unique // Har Gal department number, the department's identity; CHECK (code > 0) in SQL
  name      String   @db.VarChar(100) // Not unique; can change: the import updates it by code
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  employees           Employee[]
  templateDepartments TemplateDepartment[]
  roundTemplates      RoundTemplate[]
  assignments         Assignment[]

  @@map("departments")
}

model Employee {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeNumber String      @unique @map("employee_number") @db.VarChar(20) // Import match key
  idNumber       String      @unique @map("id_number") @db.Char(9) // Israeli ID, padded with leading zeros
  firstName      String      @map("first_name") @db.VarChar(50)
  lastName       String      @map("last_name") @db.VarChar(50)
  departmentId   String      @map("department_id") @db.Uuid
  email          String?     @db.VarChar(255)
  emailStatus    EmailStatus @map("email_status")
  phone          String?     @db.VarChar(20) // Reference only; nothing is sent to it
  isActive       Boolean     @default(true) @map("is_active")
  lastImportId   String?     @map("last_import_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  department  Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  lastImport  ImportBatch? @relation(fields: [lastImportId], references: [id], onDelete: Restrict)
  assignments Assignment[]

  @@index([departmentId])
  @@map("employees")
}

// Excel imports: saved as `preview`, then committed.
model ImportBatch {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uploadedById  String       @map("uploaded_by") @db.Uuid
  fileName      String       @map("file_name") @db.VarChar(255)
  fileKey       String       @map("file_key") // Original file in storage
  status        ImportStatus @default(preview)
  rowsTotal     Int          @default(0) @map("rows_total")
  rowsCreated   Int          @default(0) @map("rows_created")
  rowsUpdated   Int          @default(0) @map("rows_updated")
  rowsUnchanged Int          @default(0) @map("rows_unchanged")
  rowsFailed    Int          @default(0) @map("rows_failed")
  errors        Json         @default("[]") // Rows with errors and the reason
  committedAt   DateTime?    @map("committed_at") @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  uploadedBy User       @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  employees  Employee[]

  @@map("import_batches")
}

// ---------------------------------------------------------------------------
// Templates (task 1.3)
// ---------------------------------------------------------------------------

// Department PDFs. Locked after first send; edits create a new version that points to the
// previous one. parent_template_id is UNIQUE, so a template has at most one next version.
model Template {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String       @db.VarChar(150)
  kind             TemplateKind @default(signature) // MVP uses `signature`
  fileKey          String       @map("file_key") // Original PDF
  pageCount        Int          @map("page_count")
  version          Int          @default(1) // Starts at 1
  parentTemplateId String?      @unique @map("parent_template_id") @db.Uuid // Earlier version
  isLocked         Boolean      @default(false) @map("is_locked") // True after first send
  isArchived       Boolean      @default(false) @map("is_archived")
  createdById      String       @map("created_by") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy      User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
  parent         Template?            @relation("TemplateVersions", fields: [parentTemplateId], references: [id], onDelete: Restrict)
  nextVersion    Template?            @relation("TemplateVersions")
  departments    TemplateDepartment[]
  fields         TemplateField[]
  roundTemplates RoundTemplate[]
  assignments    Assignment[]

  @@map("templates")
}

// Templates ↔ departments (M:N). A department may have more than one active template;
// in by-department rounds the manager picks one (saved in round_templates).
model TemplateDepartment {
  templateId   String   @map("template_id") @db.Uuid
  departmentId String   @map("department_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  template   Template   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@id([templateId, departmentId])
  @@index([departmentId])
  @@map("template_departments")
}

// Where text and signature are drawn on the PDF. Positions and sizes are in PDF points.
model TemplateField {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId String            @map("template_id") @db.Uuid
  fieldType  TemplateFieldType @map("field_type")
  page       Int // From 1
  x          Decimal           @db.Decimal(7, 2)
  y          Decimal           @db.Decimal(7, 2)
  width      Decimal           @db.Decimal(7, 2)
  height     Decimal           @db.Decimal(7, 2)
  fontSize   Int?              @map("font_size")
  label      String?           @db.VarChar(255) // Checkbox text (later)
  isRequired Boolean           @default(true) @map("is_required")
  sortOrder  Int               @default(0) @map("sort_order")
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  template  Template             @relation(fields: [templateId], references: [id], onDelete: Restrict)
  responses AssignmentResponse[]

  @@index([templateId])
  @@map("template_fields")
}

// ---------------------------------------------------------------------------
// Rounds (task 1.4)
// ---------------------------------------------------------------------------

// Send rounds. link_expires_at is set by the app from settings when the round is created.
model Round {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String      @db.VarChar(150)
  mode                 RoundMode
  requiresSignature    Boolean     @default(true) @map("requires_signature") // False = delivery-only round (later)
  status               RoundStatus @default(draft)
  remindersEnabled     Boolean     @default(true) @map("reminders_enabled")
  reminderIntervalDays Int         @default(3) @map("reminder_interval_days")
  maxReminders         Int?        @map("max_reminders") // NULL = no limit
  linkExpiresAt        DateTime?   @map("link_expires_at") @db.Timestamptz(3)
  createdById          String      @map("created_by") @db.Uuid
  sentAt               DateTime?   @map("sent_at") @db.Timestamptz(3)
  closedAt             DateTime?   @map("closed_at") @db.Timestamptz(3)
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy   User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  templates   RoundTemplate[]
  assignments Assignment[]

  @@map("rounds")
}

// Which PDF each department gets in a round. department_id NULL = everyone (one-template mode).
// The unique index is NULLS NOT DISTINCT in the migration SQL (Prisma can't express it), so a
// round can't have two NULL rows. Prisma doesn't compare that flag, so it leaves the index alone.
model RoundTemplate {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roundId      String   @map("round_id") @db.Uuid
  departmentId String?  @map("department_id") @db.Uuid
  templateId   String   @map("template_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  round      Round       @relation(fields: [roundId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  template   Template    @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@unique([roundId, departmentId], map: "round_templates_round_id_department_id_key")
  @@map("round_templates")
}

// One employee in one round. Locked and expired are flags, not statuses (see displayStatus()).
model Assignment {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roundId          String           @map("round_id") @db.Uuid
  employeeId       String           @map("employee_id") @db.Uuid
  departmentId     String           @map("department_id") @db.Uuid // Employee's department when the round was created; never changes
  templateId       String?          @map("template_id") @db.Uuid // NULL for an external report (later)
  sourceFileKey    String?          @map("source_file_key") // Ready per-employee PDF, e.g. Har Gal (later)
  status           AssignmentStatus @default(pending)
  failedAttempts   Int              @default(0) @map("failed_attempts") @db.SmallInt // Wrong ID attempts
  lockedAt         DateTime?        @map("locked_at") @db.Timestamptz(3) // Set at 5 attempts; cleared on unlock
  sentAt           DateTime?        @map("sent_at") @db.Timestamptz(3)
  firstOpenedAt    DateTime?        @map("first_opened_at") @db.Timestamptz(3)
  lastReminderAt   DateTime?        @map("last_reminder_at") @db.Timestamptz(3)
  signedAt         DateTime?        @map("signed_at") @db.Timestamptz(3)
  reminderCount    Int              @default(0) @map("reminder_count") @db.SmallInt
  signMethod       SignMethod?      @map("sign_method")
  signedFileKey    String?          @map("signed_file_key") // round/department/employee-number_name.pdf
  signedFileSha256 String?          @map("signed_file_sha256") @db.Char(64) // Proves the file hasn't changed
  signerIp         String?          @map("signer_ip") @db.Inet
  signerUserAgent  String?          @map("signer_user_agent")
  handledById      String?          @map("handled_by") @db.Uuid // Manual scan or kiosk
  cancelledAt      DateTime?        @map("cancelled_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  round      Round                @relation(fields: [roundId], references: [id], onDelete: Restrict)
  employee   Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  department Department           @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  template   Template?            @relation(fields: [templateId], references: [id], onDelete: Restrict)
  handledBy  User?                @relation(fields: [handledById], references: [id], onDelete: Restrict)
  emails     EmailMessage[]
  responses  AssignmentResponse[]

  @@unique([roundId, employeeId])
  @@index([roundId, status]) // Round counts
  @@index([roundId, departmentId]) // Round filter and counts by department
  @@index([employeeId]) // Employee history
  @@index([status, lastReminderAt]) // Reminder job
  @@map("assignments")
}

// Every email, with its link token. Only the SHA-256 of the token is stored; a new token per email.
model EmailMessage {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId      String             @map("assignment_id") @db.Uuid
  type              EmailMessageType
  toEmail           String             @map("to_email") @db.VarChar(255) // Address actually used
  tokenHash         String?            @unique @map("token_hash") @db.Char(64) // NULL for the signed copy
  providerMessageId String?            @map("provider_message_id") @db.VarChar(255) // Matches bounce notices
  status            EmailMessageStatus @default(queued)
  error             String?
  sentAt            DateTime?          @map("sent_at") @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  @@index([assignmentId])
  @@index([providerMessageId]) // Bounce lookup
  @@map("email_messages")
}

// Checkbox and text answers (later; table ready).
model AssignmentResponse {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId    String   @map("assignment_id") @db.Uuid
  templateFieldId String   @map("template_field_id") @db.Uuid
  value           String // `true` / `false` or free text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignment    Assignment    @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  templateField TemplateField @relation(fields: [templateFieldId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, templateFieldId])
  @@map("assignment_responses")
}

// ---------------------------------------------------------------------------
// Log and settings (task 1.5)
// ---------------------------------------------------------------------------

// Activity log, append only: triggers reject UPDATE, DELETE and TRUNCATE. No updated_at.
model AuditLog {
  id         BigInt    @id @default(autoincrement())
  userId     String?   @map("user_id") @db.Uuid // NULL for employee or system
  actorType  ActorType @map("actor_type")
  action     String    @db.VarChar(50) // e.g. round.send, assignment.sign, document.view
  entityType String    @map("entity_type") @db.VarChar(50)
  entityId   String?   @map("entity_id") @db.Uuid
  details    Json      @default("{}")
  ip         String?   @db.Inet
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

// Key/value settings, e.g. reminder_interval_days, link_expiry_days, sender_name.
// The app has built-in defaults for missing keys (task 3.18); the seed fills them in dev only.
model Setting {
  key         String   @id @db.VarChar(100)
  value       Json
  updatedById String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Staff login (task 2.2)
// ---------------------------------------------------------------------------

// Staff login sessions. The cookie holds a random 256-bit token; only its SHA-256 is stored.
// Rows are deleted on logout, expiry, a refused request, or by the cleanup job (task 2.7).
model Session {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3) // Absolute limit: login + 12 h
  lastUsedAt DateTime @map("last_used_at") @db.Timestamptz(3) // Idle limit: + 30 min
  ip         String?  @db.Inet
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("sessions")
}

// Login attempts for the limit (5 per email, 20 per IP, in 15 minutes). Written before the
// password check; a successful login deletes that email's rows. No updated_at: never changed.
model LoginAttempt {
  id        BigInt   @id @default(autoincrement())
  email     String   @db.VarChar(255) // Lowercased, as typed; may not belong to any user
  ip        String?  @db.Inet
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}
