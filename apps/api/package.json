{
  "name": "@doc-signing/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "pnpm run --parallel \"/^dev:/\"",
    "dev:api": "nest start --watch --preserveWatchOutput",
    "dev:worker": "nest start --watch --preserveWatchOutput --config nest-cli.worker.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --project unit --passWithNoTests",
    "test:db": "vitest run --project db",
    "db:migrate": "prisma migrate dev",
    "postdb:migrate": "prisma generate",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "postdb:reset": "prisma generate && prisma db seed",
    "db:seed": "prisma db seed",
    "email:preview": "tsx scripts/email-preview.ts",
    "email:bounce": "tsx scripts/send-test-bounce.ts",
    "job:cleanup": "tsx scripts/run-cleanup.ts",
    "job:reminders": "tsx scripts/run-reminders.ts",
    "import:sample": "tsx scripts/import-sample.ts",
    "pdf:sample": "tsx scripts/pdf-sample.ts",
    "hebrew:samples": "tsx scripts/hebrew-samples.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "@doc-signing/shared": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@node-rs/argon2": "^2.2.2",
    "@pdf-lib/fontkit": "1.1.1",
    "@pdf-lib/upng": "1.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bidi-js": "1.1.0",
    "cookie-parser": "^1.4.7",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "multer": "2.5.0",
    "nodemailer": "10.1.7",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.1",
    "pg-boss": "12.35.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "yazl": "3.3.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "2.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "pdfjs-dist": "6.3.289",
    "prisma": "7.10.0",
    "supertest": "^7.3.1",
    "tsx": "4.23.15",
    "vitest": "5.0.4",
    "yauzl": "3.4.0"
  }
}
