{
  "name": "doc-signing",
  "private": true,
  "description": "Digital Document Signing & Tracking System",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @doc-signing/shared build && pnpm --recursive --parallel dev",
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --filter @doc-signing/shared build && pnpm --recursive typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm --filter @doc-signing/shared build && pnpm --recursive test",
    "test:db": "pnpm --filter @doc-signing/shared build && pnpm --filter @doc-signing/api test:db",
    "test:e2e": "pnpm --filter @doc-signing/web test:e2e",
    "db:migrate": "pnpm --filter @doc-signing/api db:migrate",
    "db:generate": "pnpm --filter @doc-signing/api db:generate",
    "db:studio": "pnpm --filter @doc-signing/api db:studio",
    "db:reset": "pnpm --filter @doc-signing/api db:reset",
    "db:seed": "pnpm --filter @doc-signing/api db:seed",
    "email:preview": "pnpm --filter @doc-signing/api email:preview",
    "import:sample": "pnpm --filter @doc-signing/api import:sample",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "packageManager": "pnpm@10.34.6+sha512.7e1ae66a83a9143c118cc1944f37cc4f2b8acddeda4b001cfa78908f6e46e45e15292739ca6c9d026426cc757e9318cc98c5551d6a16c165097b0028ba87b4e6",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "pnpm": {
    "overrides": {
      "qs": "6.16.1",
      "express>body-parser": "2.4.0",
      "fast-uri": "3.1.9"
    }
  }
}
